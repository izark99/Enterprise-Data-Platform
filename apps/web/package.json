    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
